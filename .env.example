# Copy to .env.local. The default local preview remains demo without a key.
VITE_RECOMMENDATION_MODE=demo
# To test actual, condition-based Gemini recommendations, set mode to gemini
# and enter the key below in .env.local only. Never prefix an API key with VITE_.
GEMINI_API_KEY=
# Production client only: full deployed Worker endpoint (no keys in this URL).
VITE_RECOMMENDATION_API_URL=
