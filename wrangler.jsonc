{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hair-fit-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "observability": { "enabled": false },
  "env": {
    "demo": { "vars": { "RECOMMENDATION_MODE": "demo" } },
    "production": { "vars": { "RECOMMENDATION_MODE": "gemini" } }
  }
}
